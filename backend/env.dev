# ---------------------------------------------------------------------------
# Development environment -- injected into the containers by
# docker-compose.dev.yml (`env_file`). Never baked into the image.
#
# The database host is the Compose service name `postgres`, resolved on the
# Compose network. The published host port (POSTGRES_HOST_PORT) is irrelevant
# here: it exists only for host -> database access.
# For running the backend directly on the host instead, copy .env.example to
# .env and point the URIs at localhost:${POSTGRES_HOST_PORT}.
# ---------------------------------------------------------------------------

ENV=dev
PORT=3000

DEV_DATABASE_URI=postgresql://postgres:postgres@postgres:5432/firewall_dev
PROD_DATABASE_URI=postgresql://postgres:postgres@postgres:5432/firewall_prod

LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log

DB_CONNECTION_INTERVAL=3000

# Consumed by the postgres image, which shares this file so the server
# credentials and the URIs above cannot drift apart.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=firewall_dev
