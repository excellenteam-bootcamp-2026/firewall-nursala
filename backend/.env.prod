# ---------------------------------------------------------------------------
# Production-style environment -- injected into the containers by
# docker-compose.prod.yml (`env_file`). Never baked into the image.
#
# !!! THESE ARE NOT REAL DEPLOYMENT CREDENTIALS !!!
# This project has no real production deployment. The values below are local
# assignment/test values, kept deliberately non-secret so that nothing
# sensitive is committed. A real deployment must supply ENV=production with
# PROD_DATABASE_URI and POSTGRES_PASSWORD from a secret store (Docker/Swarm
# secrets, a vault, or CI-injected variables) and must not use this file.
#
# The database host is the Compose service name `postgres`; the published
# host port plays no part in container-to-container traffic.
# ---------------------------------------------------------------------------

ENV=production
PORT=3000

# Required by the schema even when unused: config selects PROD_DATABASE_URI
# because ENV=production.
DEV_DATABASE_URI=postgresql://postgres:postgres@postgres:5432/firewall_dev
PROD_DATABASE_URI=postgresql://postgres:postgres@postgres:5432/firewall_prod

# LOG_LEVEL is intentionally omitted: config forces `info` in production.
LOG_FILE_PATH=logs/app.log

DB_CONNECTION_INTERVAL=3000

# Consumed by the postgres image. Replace with a secret-managed password
# before any real deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=firewall_prod
