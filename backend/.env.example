# ---------------------------------------------------------------------------
# Every environment variable the backend requires. No credentials here.
# Copy to `.env` for host-side runs (npm run dev / npm test / drizzle-kit),
# or see env.dev / .env.prod for the Compose-injected variants.
#
# src/main/config/env.ts validates these with zod at import time and throws on
# startup if ENV, PORT, DEV_DATABASE_URI, PROD_DATABASE_URI or
# DB_CONNECTION_INTERVAL is missing or malformed.
# ---------------------------------------------------------------------------

# dev | production  -- also selects which DATABASE_URI is used.
ENV=

# HTTP port the Express server listens on, 1-65535.
PORT=

# postgresql://<user>:<password>@<host>:<port>/<database>
# host = `postgres` inside Compose, `localhost` from the host machine.
DEV_DATABASE_URI=
PROD_DATABASE_URI=

# debug | info | warn | error -- optional, ignored when ENV=production (info).
LOG_LEVEL=

# Path of the log file used when ENV is not `dev`. Defaults to logs/app.log.
LOG_FILE_PATH=

# Milliseconds between Stop-and-Wait database connection attempts.
DB_CONNECTION_INTERVAL=

# Consumed by the postgres image when this file is shared with that service.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---------------------------------------------------------------------------
# Compose-only variables (repository-root .env, not this file):
#   POSTGRES_HOST_PORT   host port published for PostgreSQL   (default 5432)
#   BACKEND_HOST_PORT    host port published for the backend  (default 3000)
# ---------------------------------------------------------------------------
